# Splunk MCP Server encrypted token (generated from inside MCP Server app UI)
SPLUNK_MCP_TOKEN=your_splunk_mcp_token

# Splunk Enterprise (host=localhost, port=8089)
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_ADMIN_USER=admin
SPLUNK_ADMIN_PASSWORD=your_splunk_password

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key
